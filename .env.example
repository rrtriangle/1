# 데이터 저장 위치 (외장 SSD로 옮길 때 이 값만 바꾸면 된다)
# MARKETLAB_DATA_DIR=/Volumes/MarketSSD/market-research-lab-data
MARKETLAB_DATA_DIR=

# SEC EDGAR 정책: 연락 가능한 User-Agent 필수 (예: "홍길동 you@example.com")
MARKETLAB_SEC_USER_AGENT=

# 선택: OpenDART API 키 (한국 재무정보). 없으면 해당 수집만 건너뛴다.
DART_API_KEY=

# 선택: 다른 설정 파일 사용
# MARKETLAB_CONFIG=/path/to/settings.yaml
